# Image and port (compose.yaml)
WEB_VERSION=main
WEB_BIND=127.0.0.1:3000

# GitHub status on About. Without a token the contribution heatmap is
# hidden; events still work. A fine-grained token with no permissions is
# enough. Turn on "Include private contributions on my profile" in GitHub
# settings to count private and org contributions.
GITHUB_TOKEN=

# Traces and logs to Sensorium (OTLP/JSON). Leave the endpoint empty to send
# nothing.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=web
