{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "zyx1121",
  "homepage": "https://ui.zyx.tw",
  "items": [
    {
      "name": "base",
      "type": "registry:base",
      "title": "zyx Base",
      "description": "The zyx.tw design system base: a terminal look in one monospace face, grayscale tokens, four type sizes, square corners and two motion durations.",
      "extends": "none",
      "config": {
        "style": "base-nova",
        "iconLibrary": "lucide",
        "tailwind": {
          "baseColor": "neutral"
        },
        "registries": {
          "@zyx1121": "https://ui.zyx.tw/r/{name}.json"
        }
      },
      "dependencies": [
        "class-variance-authority",
        "cn",
        "lucide-react",
        "@base-ui/react"
      ],
      "registryDependencies": [
        "https://ui.zyx.tw/r/utils.json",
        "https://ui.zyx.tw/r/font-noto-sans-tc.json"
      ],
      "devDependencies": ["tw-animate-css", "shadcn"],
      "css": {
        "@import url(\"https://ui.zyx.tw/fonts/sarasa-mono-tc.css\")": {},
        "@import \"tw-animate-css\"": {},
        "@import \"shadcn/tailwind.css\"": {},
        "@utility duration-state": {
          "--tw-duration": "150ms",
          "transition-duration": "150ms",
          "--tw-ease": "cubic-bezier(0, 0, 0.2, 1)",
          "transition-timing-function": "cubic-bezier(0, 0, 0.2, 1)"
        },
        "@utility duration-overlay": {
          "--tw-duration": "200ms",
          "transition-duration": "200ms",
          "--tw-ease": "cubic-bezier(0, 0, 0.2, 1)",
          "transition-timing-function": "cubic-bezier(0, 0, 0.2, 1)"
        },
        "@utility w-menu": {
          "width": "calc(var(--anchor-width) + 0.5rem)"
        },
        "@utility terminal-link": {
          "&:hover, &:focus-visible": {
            "background-color": "var(--foreground)",
            "color": "var(--background)",
            "text-decoration-line": "none",
            "outline": "none",
            "box-shadow": "0 0 0 2px var(--foreground)"
          }
        },
        "@layer base": {
          "*": {
            "@apply border-border outline-ring/50": {}
          },
          "html": {
            "@apply font-sans": {}
          },
          "body": {
            "@apply bg-background text-body text-foreground": {}
          },
          ".dark": {
            "color-scheme": "dark"
          },
          "::selection": {
            "@apply bg-foreground text-background": {}
          }
        },
        "@media (prefers-reduced-motion: reduce)": {
          "*, ::before, ::after": {
            "animation-duration": "1ms !important",
            "animation-delay": "0s !important",
            "animation-iteration-count": "1 !important",
            "transition-duration": "1ms !important",
            "transition-delay": "0s !important",
            "scroll-behavior": "auto !important"
          }
        }
      },
      "cssVars": {
        "theme": {
          "text-*": "initial",
          "text-display": "5rem",
          "text-display--line-height": "5rem",
          "text-title": "1.5rem",
          "text-title--line-height": "2rem",
          "text-body": "1rem",
          "text-body--line-height": "1.5rem",
          "text-caption": "0.875rem",
          "text-caption--line-height": "1.25rem",
          "font-sans": "var(--font-sarasa-mono, Sarasa Mono TC), var(--font-noto-sans-tc), ui-monospace, monospace",
          "font-heading": "var(--font-sarasa-mono, Sarasa Mono TC), var(--font-noto-sans-tc), ui-monospace, monospace",
          "font-mono": "var(--font-sarasa-mono, Sarasa Mono TC), var(--font-noto-sans-tc), ui-monospace, monospace"
        },
        "light": {
          "background": "oklch(0.97 0.005 85)",
          "foreground": "oklch(0.25 0 0)",
          "primary": "oklch(0.25 0 0)",
          "primary-foreground": "oklch(0.97 0.005 85)",
          "muted": "oklch(0.93 0.005 85)",
          "muted-foreground": "oklch(0.52 0 0)",
          "destructive": "oklch(0.577 0.245 27.325)",
          "border": "oklch(0.89 0.005 85)",
          "input": "oklch(0.89 0.005 85)",
          "ring": "oklch(0.25 0 0)",
          "radius": "0"
        },
        "dark": {
          "background": "oklch(0.17 0 0)",
          "foreground": "oklch(0.88 0 0)",
          "primary": "oklch(0.88 0 0)",
          "primary-foreground": "oklch(0.17 0 0)",
          "muted": "oklch(0.26 0 0)",
          "muted-foreground": "oklch(0.62 0 0)",
          "destructive": "oklch(0.704 0.191 22.216)",
          "border": "oklch(1 0 0 / 10%)",
          "input": "oklch(1 0 0 / 15%)",
          "ring": "oklch(0.88 0 0)"
        }
      }
    },
