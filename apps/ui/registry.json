{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "zyx1121",
  "homepage": "https://ui.zyx.tw",
  "items": [
    {
      "name": "base",
      "type": "registry:base",
      "title": "zyx Base",
      "description": "The zyx.tw design system base: grayscale tokens, four type sizes, a concentric radius scale and two motion durations.",
      "extends": "none",
      "config": {
        "style": "base-nova",
        "iconLibrary": "lucide",
        "tailwind": {
          "baseColor": "neutral"
        },
        "registries": {
          "@zyx1121": "https://ui.zyx.tw/r/{name}.json"
        }
      },
      "dependencies": [
        "class-variance-authority",
        "cn",
        "lucide-react",
        "@base-ui/react"
      ],
      "registryDependencies": [
        "https://ui.zyx.tw/r/utils.json",
        "https://ui.zyx.tw/r/font-inter.json",
        "https://ui.zyx.tw/r/font-noto-sans-jp.json",
        "https://ui.zyx.tw/r/font-noto-sans-tc.json",
        "https://ui.zyx.tw/r/font-geist-mono.json"
      ],
      "devDependencies": ["tw-animate-css", "shadcn"],
      "css": {
        "@import \"tw-animate-css\"": {},
        "@import \"shadcn/tailwind.css\"": {},
        "@utility duration-state": {
          "--tw-duration": "150ms",
          "transition-duration": "150ms",
          "--tw-ease": "cubic-bezier(0, 0, 0.2, 1)",
          "transition-timing-function": "cubic-bezier(0, 0, 0.2, 1)"
        },
        "@utility duration-overlay": {
          "--tw-duration": "200ms",
          "transition-duration": "200ms",
          "--tw-ease": "cubic-bezier(0, 0, 0.2, 1)",
          "transition-timing-function": "cubic-bezier(0, 0, 0.2, 1)"
        },
        "@utility w-menu": {
          "width": "calc(var(--anchor-width) + 0.5rem)"
        },
        "@layer base": {
          "*": {
            "@apply border-border outline-ring/50": {}
          },
          "html": {
            "@apply font-sans": {}
          },
          "body": {
            "@apply bg-background text-body text-foreground": {}
          },
          ".dark": {
            "color-scheme": "dark"
          }
        },
        "@media (prefers-reduced-motion: reduce)": {
          "*, ::before, ::after": {
            "animation-duration": "1ms !important",
            "animation-delay": "0s !important",
            "animation-iteration-count": "1 !important",
            "transition-duration": "1ms !important",
            "transition-delay": "0s !important",
            "scroll-behavior": "auto !important"
          }
        }
      },
      "cssVars": {
        "theme": {
          "text-*": "initial",
          "text-display": "5rem",
          "text-display--line-height": "5rem",
          "text-title": "1.5rem",
          "text-title--line-height": "2rem",
          "text-body": "1rem",
          "text-body--line-height": "1.5rem",
          "text-caption": "0.875rem",
          "text-caption--line-height": "1.25rem",
          "font-sans": "var(--font-inter), var(--font-noto-sans-jp), var(--font-noto-sans-tc), ui-sans-serif, system-ui, sans-serif",
          "font-heading": "var(--font-inter), var(--font-noto-sans-jp), var(--font-noto-sans-tc), ui-sans-serif, system-ui, sans-serif",
          "font-mono": "var(--font-geist-mono), ui-monospace, monospace",
          "default-font-feature-settings": "\"liga\" 1, \"calt\" 1, \"ss01\" 1, \"zero\" 1",
          "radius-control": "var(--radius)",
          "radius-menu": "calc(var(--radius) + 0.25rem)",
          "radius-surface": "calc(var(--radius) + 1.5rem)"
        },
        "light": {
          "background": "oklch(1 0 0)",
          "foreground": "oklch(0.145 0 0)",
          "primary": "oklch(0.205 0 0)",
          "primary-foreground": "oklch(0.985 0 0)",
          "muted": "oklch(0.97 0 0)",
          "muted-foreground": "oklch(0.54 0 0)",
          "destructive": "oklch(0.577 0.245 27.325)",
          "border": "oklch(0.922 0 0)",
          "input": "oklch(0.922 0 0)",
          "ring": "oklch(0.708 0 0)",
          "radius": "1rem"
        },
        "dark": {
          "background": "oklch(0 0 0)",
          "foreground": "oklch(0.985 0 0)",
          "primary": "oklch(0.922 0 0)",
          "primary-foreground": "oklch(0.205 0 0)",
          "muted": "oklch(0.269 0 0)",
          "muted-foreground": "oklch(0.65 0 0)",
          "destructive": "oklch(0.704 0.191 22.216)",
          "border": "oklch(1 0 0 / 10%)",
          "input": "oklch(1 0 0 / 15%)",
          "ring": "oklch(0.556 0 0)"
        }
      }
    },
