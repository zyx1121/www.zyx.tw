    {
      "name": "frame",
      "type": "registry:ui",
      "title": "Frame",
      "description": "Glyph frames: an outline drawn with box-drawing characters, so its lines run through the middle of a character cell and its corners are the font's arcs. Every window and field draws its edge with it.",
      "registryDependencies": ["https://ui.zyx.tw/r/utils.json"],
      "files": [
        {
          "path": "registry/zyx/ui/frame.tsx",
          "type": "registry:ui"
        }
      ],
      "css": {
        "[data-slot=\"frame-edges\"]": {
          "position": "absolute",
          "inset": "calc(var(--text-caption--line-height) / -2) -0.5ch",
          "z-index": "1",
          "display": "grid",
          "grid-template-columns": "1ch minmax(0, 1fr) 1ch",
          "grid-template-rows": "var(--text-caption--line-height) minmax(0, 1fr) var(\n      --text-caption--line-height\n    )",
          "font-family": "var(--font-mono)",
          "font-size": "var(--text-body)",
          "font-weight": "400",
          "line-height": "var(--text-caption--line-height)",
          "white-space": "pre",
          "text-align": "start",
          "pointer-events": "none",
          "user-select": "none"
        },
        "[data-slot=\"frame-edges\"] > *": {
          "display": "flex",
          "min-width": "0"
        },
        "[data-slot=\"frame-edges\"] [data-frame-text]": {
          "flex": "none",
          "padding-inline": "1ch",
          "color": "var(--foreground)"
        },
        "[data-edge=\"fill\"]": {
          "flex": "1",
          "min-width": "0",
          "margin-inline": "-1px",
          "overflow": "hidden"
        },
        "[data-edge=\"top-left\"]::before": {
          "content": "\"╭\" / \"\""
        },
        "[data-edge=\"top-right\"]::before": {
          "content": "\"╮\" / \"\""
        },
        "[data-edge=\"bottom-left\"]::before": {
          "content": "\"╰\" / \"\""
        },
        "[data-edge=\"bottom-right\"]::before": {
          "content": "\"╯\" / \"\""
        },
        "[data-edge=\"lead\"]::before": {
          "content": "\"─\" / \"\""
        },
        "[data-edge=\"fill\"]::before": {
          "content": "\"────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────\" /\n    \"\""
        },
        "[data-edge=\"side\"]": {
          "display": "block",
          "margin-block": "-1px",
          "overflow": "hidden",
          "word-break": "break-all",
          "white-space": "normal"
        },
        "[data-edge=\"side\"]::before": {
