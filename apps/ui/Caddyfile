# ui.zyx.tw in its container: the static export in /srv, served the way
# vercel.json served it (clean URLs, Markdown twins, CORS on the registry and
# fonts). TLS ends at the gateway, so this listens on plain HTTP.
{
	admin off
	auto_https off
}

:3000 {
	root * /srv
	encode zstd gzip

	# Clean URLs: /button serves button.html; /button.html and /button/
	# redirect to it. The captures are slug characters only, so a crafted path
	# (/%5Cevil.com.html) can never become a redirect to another host.
	redir /index.html / 308
	@html path_regexp html ^(/[a-z0-9-]+(?:/[a-z0-9-]+)*)\.html$
	redir @html {re.html.1} 308
	@slash path_regexp slash ^(/[a-z0-9-]+(?:/[a-z0-9-]+)*)/$
	redir @slash {re.slash.1} 308

	# A component's Markdown twin, /button.md, lives at /md/button.
	@twinfile {
		path_regexp twin ^/([a-z0-9-]+)\.md$
		not file
	}
	rewrite @twinfile /md/{re.twin.1}

	@markdown path_regexp ^/([a-z0-9-]+)\.md$
	header @markdown Content-Type "text/markdown; charset=utf-8"
	header /llms.txt Content-Type "text/plain; charset=utf-8"
	header /opengraph-image Content-Type "image/png"

	header / Link "</llms.txt>; rel=\"describedby\", </index.md>; rel=\"alternate\"; type=\"text/markdown\""
	@page path_regexp page ^/([a-z0-9-]+)$
	header @page Link "</{re.page.1}.md>; rel=\"alternate\"; type=\"text/markdown\""

	@registry path /r/*
	header @registry {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Methods "GET, OPTIONS"
		Cache-Control "public, max-age=0, must-revalidate"
	}
	@fonts path /fonts/*
	header @fonts {
		Access-Control-Allow-Origin *
		Cache-Control "public, max-age=86400"
	}

	try_files {path}.html {path} {path}/index.html
	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
