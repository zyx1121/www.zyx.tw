# env/link.env on the host (compose.yaml), or .env.local in development.
# Pooled Neon Postgres URL for the shared zyx-tw database.
DATABASE_URL=

# Traces and logs to Sensorium (OTLP/JSON). Leave the endpoint empty to send
# nothing.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=link
