{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    // migrated app predates the shared base's noUncheckedIndexedAccess;
    // opting out here to avoid unrelated code changes during the move
    "noUncheckedIndexedAccess": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.mjs",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", "**/*.test.ts"]
}
