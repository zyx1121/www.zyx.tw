# env/1909.env on the host (compose.yaml), or .env.local in development.
DATABASE_URL=            # pooled Neon URL
BETTER_AUTH_SECRET=      # openssl rand -base64 32
BETTER_AUTH_URL=https://1909.zyx.tw
GOOGLE_CLIENT_ID=
