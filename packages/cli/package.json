{
  "name": "zyxui",
  "version": "0.1.0",
  "type": "module",
  "description": "The zyx UI registry CLI — copy Loki's components into a Next.js project. One registry, one theme, no style matrix.",
  "license": "MIT",
  "author": "zyx1121 <yongxiang.zhan@outlook.com>",
  "homepage": "https://ui.zyx.tw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zyx1121/www.zyx.tw.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/zyx1121/www.zyx.tw/issues",
  "keywords": [
    "zyx",
    "ui",
    "registry",
    "components",
    "tailwind",
    "next"
  ],
  "bin": {
    "zyxui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
