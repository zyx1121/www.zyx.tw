{
  "name": "@workspace/otel",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "description": "Sensorium observability producer — shared OTel bootstrap, client attribution, and log emission for every app in the workspace",
  "scripts": {
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@vercel/otel": "^2.1.3",
    "next": "^16.1.6"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3"
  },
  "exports": {
    "./register": {
      "source": "./src/register.ts",
      "default": "./src/register.ts"
    },
    "./attribution": {
      "source": "./src/attribution.ts",
      "default": "./src/attribution.ts"
    },
    "./log": {
      "source": "./src/log.ts",
      "default": "./src/log.ts"
    },
    "./on-request-error": {
      "source": "./src/on-request-error.ts",
      "default": "./src/on-request-error.ts"
    },
    "./layout": {
      "source": "./src/layout.ts",
      "default": "./src/layout.ts"
    }
  }
}
