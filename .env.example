# Next to compose.yaml on the host. Each app listens on port 3000 in its
# container; *_BIND is the host address the gateway proxies to.
WEB_VERSION=main
WEB_BIND=127.0.0.1:3000
UI_VERSION=main
UI_BIND=127.0.0.1:3001
GOOD_VERSION=main
GOOD_BIND=127.0.0.1:3002
TIME_VERSION=main
TIME_BIND=127.0.0.1:3003
LINK_VERSION=main
LINK_BIND=127.0.0.1:3004
APP_1909_VERSION=main
APP_1909_BIND=127.0.0.1:3005
PLUMP_VERSION=main
PLUMP_BIND=127.0.0.1:3006

# www.zyx.tw reads its own settings from this file too (apps/web/.env.example).
